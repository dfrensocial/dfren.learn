rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isEnrolled(courseId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/enrollments/$(courseId));
    }

    match /courses/{courseId} {
      allow read: if resource.data.published == true;
      allow write: if false; // admin SDK (server) only

      match /lessons/{lessonId} {
        // Only title/order/status live on this doc — muxPlaybackId/muxAssetId
        // live in the private `mux/data` subdoc below instead, so this is
        // safe to list/get for anyone regardless of enrollment.
        allow read: if true;
        allow write: if false; // admin SDK (server) only

        match /mux/{doc} {
          allow get: if isEnrolled(courseId);
          allow list: if false; // no query can return this — must be a known-ID get
          allow write: if false; // admin SDK (server) only
        }
      }
    }

    // Downloadable course materials. The metadata doc is readable by enrolled
    // students (for the list); the file bytes live in a sibling subdoc that no
    // client can ever read — they're only served through /api/resources.
    match /courses/{courseId}/resources/{resourceId} {
      allow read: if isEnrolled(courseId);
      allow write: if false; // admin SDK (scripts/upload-resource.ts) only

      match /file/{doc} {
        allow read, write: if false;
      }
    }

    match /watermarks/{watermarkId} {
      allow read, write: if false; // admin SDK (server) only — issued in playback-token, read by the watermark checker
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /enrollments/{courseId} {
        allow read: if isOwner(userId);
        allow write: if false; // only the Razorpay webhook (admin SDK) grants enrollments
      }

      match /activeSessions/{sessionId} {
        allow read, write: if false; // admin SDK (server) only — concurrent-stream tracking
      }

      // Watch progress — written by /api/mux/heartbeat (admin SDK) only.
      match /progress/{courseId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /downloads/{eventId} {
        allow read, write: if false; // admin SDK (server) only — audit trail
      }

      match /legalAcceptances/{versionId} {
        allow read, write: if false; // admin SDK (server) only — proof of which Terms/Privacy version was accepted
      }

      match /loginEvents/{eventId} {
        allow read, write: if false; // admin SDK (server) only — manual audit trail
      }
    }
  }
}
