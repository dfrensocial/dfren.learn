rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isEnrolled(courseId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/enrollments/$(courseId));
    }

    match /courses/{courseId} {
      allow read: if resource.data.published == true;
      allow write: if false; // admin SDK (server) only

      match /lessons/{lessonId} {
        // A list query can't be validated against isEnrolled()/field-presence
        // conditions (Firestore can only permit a list when the query mirrors
        // the rule as a simple field filter), so listing lesson metadata
        // (titles/order) is public here. That's safe: Mux assets are signed-
        // policy, so a bare playbackId is useless without a token, and
        // /api/mux/playback-token independently re-checks enrollment before
        // issuing one. `get` (a direct single-doc fetch) stays gated.
        allow list: if true;
        allow get: if isEnrolled(courseId) || !("muxPlaybackId" in resource.data);
        allow write: if false; // admin SDK (server) only
      }
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /enrollments/{courseId} {
        allow read: if isOwner(userId);
        allow write: if false; // only the Razorpay webhook (admin SDK) grants enrollments
      }
    }
  }
}
