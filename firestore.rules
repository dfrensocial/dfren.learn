rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isEnrolled(courseId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/enrollments/$(courseId));
    }

    match /courses/{courseId} {
      allow read: if resource.data.published == true;
      allow write: if false; // admin SDK (server) only

      match /lessons/{lessonId} {
        // Only title/order/status live on this doc — muxPlaybackId/muxAssetId
        // live in the private `mux/data` subdoc below instead, so this is
        // safe to list/get for anyone regardless of enrollment.
        allow read: if true;
        allow write: if false; // admin SDK (server) only

        match /mux/{doc} {
          allow get: if isEnrolled(courseId);
          allow list: if false; // no query can return this — must be a known-ID get
          allow write: if false; // admin SDK (server) only
        }
      }
    }

    match /watermarks/{watermarkId} {
      allow read, write: if false; // admin SDK (server) only — issued in playback-token, read by the watermark checker
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /enrollments/{courseId} {
        allow read: if isOwner(userId);
        allow write: if false; // only the Razorpay webhook (admin SDK) grants enrollments
      }

      match /activeSessions/{sessionId} {
        allow read, write: if false; // admin SDK (server) only — concurrent-stream tracking
      }

      match /loginEvents/{eventId} {
        allow read, write: if false; // admin SDK (server) only — manual audit trail
      }
    }
  }
}
